# Database configuration
# Preferred full connection string for SQLAlchemy/psycopg. Left empty by
# default: the discrete settings below are the documented local path, and they
# match the Postgres service in compose.yaml.
DATABASE_URL=

# Database `make test-integration` targets. It must not be the development
# database -- the integration fixtures drop every table between tests.
# docker/postgres/initdb/01-create-test-database.sql creates it on first boot.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/insurance_claims_test

# Alternative discrete settings used when DATABASE_URL is not set.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=insurance_claims

# Logging
APP_ENV=development
LOG_LEVEL=

# Docker Compose reverse proxy
NGINX_PORT=8080
PROXY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://api.langfuse.com

# LLM and RAG settings
LLM_PROVIDER=
LLM_BASE_URL= # Optional base URL for the LLM provider
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
LLM_MODEL_VISION= # Optional; required for `make escalate-vision-boundaries` and `make validate-parsing-quality-sample`

# OpenRouter provider pin for the vision model (default: ["google-vertex/global"], no fallback).
LLM_VISION_PROVIDER_ORDER=
LLM_VISION_ALLOW_FALLBACKS=

# Vision model pricing, USD per 1M tokens (defaults: 0.30 input / 2.50 output).
LLM_VISION_INPUT_COST_PER_1M_TOKENS_USD=
LLM_VISION_OUTPUT_COST_PER_1M_TOKENS_USD=

# OpenRouter provider pin for the classification model (default: ["baidu/fp8"], no fallback).
LLM_CLASSIFICATION_PROVIDER_ORDER=
LLM_CLASSIFICATION_ALLOW_FALLBACKS=

# Concurrent classification workers per document during `make parse` (default: 10).
LLM_CLASSIFICATION_MAX_WORKERS=

# OpenRouter provider pin for the reasoning model (default: ["streamlake"], no fallback).
# Consumed from M4-05 (the compatibility assessment node) onward.
LLM_REASONING_PROVIDER_ORDER=
LLM_REASONING_ALLOW_FALLBACKS=

# OpenRouter provider pin for the fast model (default: ["baidu/fp8"], no fallback).
# Used by `make eval-intake` (M4-02) and the agent graph's fast-model nodes.
LLM_FAST_PROVIDER_ORDER=
LLM_FAST_ALLOW_FALLBACKS=

# Dense-retrieval embedding model. Pinned to an exact Hub revision in code
# (app/src/infrastructure/rag/embedding_config.py); this key is the
# human-facing name and is cross-checked against that pin by a test. See
# docs/EMBEDDINGS.md for the choice and its evidence.
EMBEDDING_MODEL=Alibaba-NLP/gte-multilingual-base

# Cross-encoder reranker [M3-05]. Pinned to an exact Hub revision in code
# (app/src/infrastructure/rag/reranker_config.py); this key is the human-facing
# name and is cross-checked against that pin by a test. See docs/RERANKING.md
# for the choice and its evidence.
RERANKER_MODEL=Alibaba-NLP/gte-multilingual-reranker-base

# Chunks embedded per batch by `make embed-chunks` (default: 64). Pure
# throughput / memory knob -- no effect on the stored vectors (the embedding
# cache key deliberately excludes it). Classified as a `.env` knob per the
# [M1-09] per-constant table in docs/EMBEDDINGS.md, the analog of
# LLM_CLASSIFICATION_MAX_WORKERS. Lower it on a memory-constrained machine.
EMBEDDING_BATCH_SIZE=

# Asynchronous processing -- [M5-05]
# The queue `make worker` drains and `POST /v1/assessments` writes to.
REDIS_URL=redis://localhost:6379/0
# Redis `make test-integration` uses (defaults to REDIS_URL's host if unset).
TEST_REDIS_URL=redis://localhost:6379/0
# Concurrent assessment runs (== worker processes). This is the parallelism
# bound on the LLM provider. Keep at 1 on a memory-constrained box -- each
# worker loads the embedder + cross-encoder. Default: 2.
ASSESSMENT_WORKER_CONCURRENCY=
# Total attempt budget for a job on *transient* provider failures (429 / 5xx /
# dropped connection). Real errors are never retried. Default: 3.
ASSESSMENT_MAX_RETRIES=
# Wait before each retry, seconds, as a JSON list (repeats its last value if
# shorter than the retry count). Default: [30, 120, 300].
ASSESSMENT_RETRY_BACKOFF_SECONDS=
# How long one queued assessment may run before RQ kills it. Default: 1800.
ASSESSMENT_JOB_TIMEOUT_SECONDS=

# Text extraction
# A page with fewer extracted characters than this is flagged as a
# candidate extraction failure in docs/TEXT_EXTRACTION_REPORT.md.
EXTRACTION_LOW_CHAR_PAGE_THRESHOLD=40

# Rasterization DPI used by the OCR path (documents with no text layer).
OCR_DPI=150
