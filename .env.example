# Database configuration
# Preferred full connection string for SQLAlchemy/psycopg. Left empty by
# default: the discrete settings below are the documented local path, and they
# match the Postgres service in docker-compose.yaml.
DATABASE_URL=

# Database `make test-integration` targets. It must not be the development
# database -- the integration fixtures drop every table between tests.
# docker/postgres/initdb/01-create-test-database.sql creates it on first boot.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/insurance_claims_test

# Alternative discrete settings used when DATABASE_URL is not set.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=insurance_claims

# Logging
APP_ENV=development
LOG_LEVEL=

# Docker Compose reverse proxy
NGINX_PORT=8080
PROXY_HEADERS_ENABLED=true
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://api.langfuse.com

# LLM and RAG settings
LLM_PROVIDER=
LLM_BASE_URL= # Optional base URL for the LLM provider
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
LLM_MODEL_VISION= # Optional; required for `make escalate-vision-boundaries` and `make validate-parsing-quality-sample`

# OpenRouter provider pin for the vision model (default: ["google-vertex"], no fallback).
LLM_VISION_PROVIDER_ORDER=
LLM_VISION_ALLOW_FALLBACKS=

# Vision model pricing, USD per 1M tokens (defaults: 0.30 input / 2.50 output).
LLM_VISION_INPUT_COST_PER_1M_TOKENS_USD=
LLM_VISION_OUTPUT_COST_PER_1M_TOKENS_USD=

# OpenRouter provider pin for the classification model (default: ["baidu/fp8"], no fallback).
LLM_CLASSIFICATION_PROVIDER_ORDER=
LLM_CLASSIFICATION_ALLOW_FALLBACKS=

# Concurrent classification workers per document during `make parse` (default: 10).
LLM_CLASSIFICATION_MAX_WORKERS=

EMBEDDING_MODEL=
RERANKER_MODEL=

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Text extraction
# A page with fewer extracted characters than this is flagged as a
# candidate extraction failure in docs/TEXT_EXTRACTION_REPORT.md.
EXTRACTION_LOW_CHAR_PAGE_THRESHOLD=40

# Rasterization DPI used by the OCR path (documents with no text layer).
OCR_DPI=150
